{
  "manifest_version": 3,
  "name": "Miss Poppy Rabbit Sync",
  "version": "1.0.0",
  "description": "Syncs your Google Calendar / Outlook (secret ICS address) to your Miss Poppy Rabbit device.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://prabbit.local/*",
    "http://*.local/*",
    "http://192.168.0.0/16",
    "https://calendar.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
